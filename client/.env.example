# Copy this file to .env and fill in your Firebase values
# cp .env.example .env

# ── Firebase ──────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-gcp-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# ── Backend API URL ───────────────────────────────────────────────────────────
# Leave empty for local dev (Vite proxy handles /api → localhost:8080)
# Set to your deployed backend URL for Netlify/Vercel production:
#   e.g. https://your-backend.railway.app
VITE_API_URL=
